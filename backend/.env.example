# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5050

# A Postgres connection string — used in both local dev and production.
# Get a free one at neon.tech: create one project, then use its "dev"
# branch connection string here (and a separate "production"/default
# branch for the deployed app — never develop against the same branch
# production uses). Looks like:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Required — the server refuses to start without this. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Leave blank to run entirely on the deterministic
# recommendation engine — the app is fully functional without this key,
# it just won't have the LLM-phrased explanations layered on top.
OPENAI_API_KEY=

# The deployed frontend's origin, e.g. https://meal-finder.vercel.app —
# only needed in production (set NODE_ENV=production too). Local dev
# origins (localhost:3002/5173) are only allowed when NODE_ENV is not
# "production", regardless of this value.
CLIENT_ORIGIN=

# Optional. Powers the external recipe search fallback (backend/services/
# recipeProvider.js) used when the local 110-recipe catalog doesn't have
# enough matches for a search. Get a free key at spoonacular.com/food-api
# (no credit card required; 50 points/day free). The app is fully
# functional on the local catalog alone without this key — it just won't
# expand beyond the local 110 recipes.
RECIPE_API_KEY=

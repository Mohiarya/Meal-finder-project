# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5050

# Local dev: a file-based SQLite DB is fine. See README's "Deployment"
# section for why this needs to change for a real hosted deployment.
DATABASE_URL="file:./dev.db"

# Required — the server refuses to start without this. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Leave blank to run entirely on the deterministic
# recommendation engine — the app is fully functional without this key,
# it just won't have the LLM-phrased explanations layered on top.
OPENAI_API_KEY=

# The deployed frontend's origin, e.g. https://meal-finder.vercel.app —
# only needed in production. Local dev origins (localhost:3002/5173) are
# always allowed regardless of this value.
CLIENT_ORIGIN=
